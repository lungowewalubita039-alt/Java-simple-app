<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controllers.CustomerController" style="-fx-font-family: 'Segoe UI'; -fx-background-color: #fafafa;">
    
    <!-- Define hidden components that the Controller can summon later -->
    <fx:define>
        <GridPane fx:id="dialogForm" hgap="10" vgap="10">
            <padding><Insets top="20" right="50" bottom="10" left="10"/></padding>
            
            <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #333333;"/>
            <TextField fx:id="dialogNameField" promptText="Customer Name" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-background-color: white; -fx-border-color: #d1d1d1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 5;"/>
            
            <Label text="Province:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #333333;"/>
            <ComboBox fx:id="dialogProvinceComboBox" promptText="Select Province" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-background-color: white; -fx-border-color: #d1d1d1; -fx-border-radius: 4; -fx-background-radius: 4;"/>
        </GridPane>
    </fx:define>

    <!-- Main Window Layout -->
    <top>
        <!-- Changed Name Here -->
        <Label text="Customer Manager" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111111;" BorderPane.alignment="CENTER">
            <padding><Insets top="15" bottom="15"/></padding>
        </Label>
    </top>

    <center>
        <TableView fx:id="customerTable" style="-fx-background-radius: 6; -fx-border-radius: 6; -fx-border-color: #e5e5e5; -fx-background-color: white;">
            <columns>
                <TableColumn fx:id="nameCol" text="Name" prefWidth="250"/>
                <TableColumn fx:id="provinceCol" text="Province" prefWidth="250"/>
            </columns>
            <BorderPane.margin>
                <Insets left="15" right="15"/>
            </BorderPane.margin>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            <!-- Add is now Green (#107c10), Delete is still Red (#c42b1c) -->
            <Button text="Add Customer..." onAction="#handleAddCustomer" defaultButton="true" style="-fx-background-color: #107c10; -fx-text-fill: white; -fx-background-radius: 4; -fx-padding: 6 14; -fx-cursor: hand;"/>
            <Button text="Delete Selected" onAction="#handleDeleteCustomer" style="-fx-background-color: #c42b1c; -fx-text-fill: white; -fx-background-radius: 4; -fx-padding: 6 14; -fx-cursor: hand;"/>
        </HBox>
    </bottom>
</BorderPane>